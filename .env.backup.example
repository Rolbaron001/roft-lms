# Settings for the nightly backup. Copy to ~/.env.backup on the server and
# chmod 600 it — it holds the key that protects every backup you have.

# --- The database being backed up -------------------------------------------
# Reached through the container's published port, or directly if Postgres is
# installed on the host. See DEPLOY.md.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=roft_lms

# --- Encryption -------------------------------------------------------------
# Generate with: openssl rand -base64 36
#
# STORE THIS SOMEWHERE OTHER THAN THIS SERVER. A password manager, not a file
# on the machine. If the server is lost and this went with it, every backup is
# permanently unreadable — which is the one failure that makes the whole
# arrangement pointless.
BACKUP_PASSPHRASE=

# --- Where backups go -------------------------------------------------------
BACKUP_DIR=/var/backups/roft-lms
BACKUP_RETAIN_DAYS=30

# S3-compatible object storage. Oracle Object Storage works; the endpoint and
# credentials come from the OCI console under Customer Secret Keys.
# Configure the credentials themselves with: aws configure
BACKUP_BUCKET=s3://your-bucket/roft-lms
BACKUP_S3_ENDPOINT=https://<namespace>.compat.objectstorage.af-johannesburg-1.oraclecloud.com

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real credentials never get committed; the templates do.
.env*
!.env.example
!.env.backup.example

# locally uploaded evidence and course media (S3-compatible storage in deployment)
/storage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

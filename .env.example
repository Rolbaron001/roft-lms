# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two connections on purpose. The application uses the first and is bound by
# row-level security; migrations and tenant provisioning use the second.
# See db/client.ts for why they are separated.

# Application role. Subject to tenant isolation. Used by every web request.
DATABASE_URL="postgresql://roft_app:CHANGE_ME@localhost:5432/roft_lms"

# Owner role. Not subject to tenant isolation. Migrations and seeding only.
DATABASE_ADMIN_URL="postgresql://postgres:CHANGE_ME@localhost:5432/roft_lms"

# Password assigned to the roft_app role when the policies script creates it.
# Must match the password in DATABASE_URL above.
ROFT_APP_DB_PASSWORD="CHANGE_ME"

DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Object storage (evidence uploads, video, SCORM packages, certificates)
# ---------------------------------------------------------------------------
# S3-compatible. Left blank for local development, where uploads are written
# to ./storage instead. Filled in when the system is deployed.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# Hostname that serves the Platform Owner console. Tenants are reached at
# their own subdomain or custom domain.
PLATFORM_HOST="localhost:3000"

# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two connections on purpose. The application uses the first and is bound by
# row-level security; migrations and tenant provisioning use the second.
# See db/client.ts for why they are separated.

# Application role. Subject to tenant isolation. Used by every web request.
DATABASE_URL="postgresql://roft_app:CHANGE_ME@localhost:5432/roft_lms"

# Owner role. Not subject to tenant isolation. Migrations and seeding only.
DATABASE_ADMIN_URL="postgresql://postgres:CHANGE_ME@localhost:5432/roft_lms"

# Password assigned to the roft_app role when the policies script creates it.
# Must match the password in DATABASE_URL above.
ROFT_APP_DB_PASSWORD="CHANGE_ME"

DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Seals each person's AI extension token at rest. Optional.
#
# Generate with: openssl rand -base64 32
#
# Left empty, the key is derived from AUTH_SECRET, which works but ties the two
# together: rotating the session secret then invalidates every stored token and
# each person has to paste theirs again. Setting this lets them rotate
# independently. Changing it has the same effect as rotating AUTH_SECRET did -
# stored tokens stop opening - so set it once, before anybody stores one.
AI_TOKEN_KEY=""

# ---------------------------------------------------------------------------
# Object storage (evidence uploads, video, SCORM packages, certificates)
# ---------------------------------------------------------------------------
# S3-compatible. Left blank for local development, where uploads are written
# to ./storage instead. Filled in when the system is deployed.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Bucket in the path (https://host/bucket/key) rather than in the host name.
# True suits every S3-compatible provider; set it to "false" only for AWS
# proper, or where the provider has issued a wildcard certificate.
S3_FORCE_PATH_STYLE="true"
#
# Switching STORAGE_DRIVER to "s3" moves evidence off this server. Two things
# follow, and both are easy to miss:
#   - files already written to ./storage are NOT copied across. Move them, or
#     the records pointing at them stop resolving.
#   - the nightly backup then covers the database only. The bucket needs its
#     own versioning and replication at the provider.

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# Hostname that serves the Platform Owner console. Tenants are reached at
# their own subdomain or custom domain.
PLATFORM_HOST="localhost:3000"

# --- Who operates this deployment ----------------------------------------
# The same application is deployed more than once: ROFT runs an instance for
# its own clients, Curiosa Academy runs another for theirs. These three name
# whoever operates *this* one. Nothing about an operator is compiled in.
#
#   PLATFORM_ORG_SLUG          the organisation row that sits at the top
#   PLATFORM_NAME              shown before any tenant resolves (tab title,
#                              the sign-in page of an unrecognised host)
#   PLATFORM_REFERENCE_PREFIX  printed before a certificate reference, e.g.
#                              CURIOSA-4K2WD-... Letters only, 2 to 12 of them.
#
# Changing the prefix does not invalidate references already issued: they are
# verified on their random body, not on the prefix.
PLATFORM_ORG_SLUG="roft"
PLATFORM_NAME="ROFT"
PLATFORM_REFERENCE_PREFIX="ROFT"
# A small illustration for empty screens, served from /public. Optional.
PLATFORM_ILLUSTRATION=""

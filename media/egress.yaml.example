# The recorder, for the LMS classroom's transcripts. Copy to egress.yaml on the
# media server and put in the same key and secret the LMS sites use.
api_key: LIVEKIT_API_KEY
api_secret: LIVEKIT_API_SECRET
ws_url: ws://127.0.0.1:7880
redis:
  address: 127.0.0.1:6379
health_port: 8791
log_level: info
# Voice files are written under /recordings, which the transcriber reads.

# Reverse proxy and TLS.
#
# Caddy obtains and renews certificates from Let's Encrypt automatically, which
# is why it is here rather than nginx: an expired certificate on a
# learner-facing system is an avoidable outage, and manual renewal is the thing
# everyone forgets.
#
# Certificates are issued on demand, one per hostname, rather than from a
# single wildcard. A wildcard would need a DNS challenge — meaning DNS provider
# credentials stored on this server — and it would still not cover a client
# using their own domain, which the tenant model supports. On-demand issuance
# covers both, and a new tenant works as soon as their DNS points here, with no
# change to this file and no restart.
#
# The `ask` endpoint is what makes that safe: Caddy asks the application
# whether a hostname belongs to a real tenant before requesting anything.
# Without it, any stranger pointing a domain at this address could exhaust the
# certificate authority's rate limit and lock out genuine tenants.

{
	email {$LMS_TLS_EMAIL}

	# `ask` is the whole control. Caddy removed its own rate-limit options
	# (`interval`/`burst`) precisely because they gave false comfort: they
	# throttled issuance without ever answering whether the hostname was
	# legitimate. This endpoint answers that.
	on_demand_tls {
		ask http://app:3000/api/tls/allow
	}
}

(lms) {
	encode zstd gzip

	# The application resolves the tenant from the hostname, so the original
	# Host must survive the hop. Getting this wrong is what makes every page
	# report "this address is not in use".
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	header {
		# One year, and only meaningful once the domain is known good.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Evidence uploads and video can be large; the default would reject them.
	request_body {
		max_size 512MB
	}

	log {
		output file /data/access.log {
			roll_size 20MB
			roll_keep 10
		}
		# Learner emails and tenant hostnames appear in URLs, so the access log
		# is personal data under POPIA. Kept short and rotated.
		format json
	}
}

# The platform console. Named explicitly so its certificate is obtained at
# startup rather than waiting for the first visitor.
{$LMS_DOMAIN} {
	import lms
}

# Every tenant hostname: subdomains of the platform domain, and clients on
# their own domains. Matched only when nothing above matches.
https:// {
	tls {
		on_demand
	}
	import lms
}
